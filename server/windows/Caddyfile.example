# ตัวกลาง HTTPS สำหรับเครื่องแล็บ (คัดลอกเป็น C:\PelNav\caddy\Caddyfile แล้วแก้ 2 บรรทัดที่มี <...>)
# หมอเปิด https://<ชื่อเว็บ>:8090 ผ่าน VPN · Caddy ถือใบรับรอง แล้วส่งต่อให้โปรแกรม PelNav ที่ฟังเฉพาะในเครื่อง (127.0.0.1:8091)
# ใบรับรองต้องออกโดยผู้ออกที่ iPad เชื่อถืออยู่แล้ว (ของมหาวิทยาลัย หรือ Let's Encrypt) หมอจึงไม่ต้องตั้งค่าอะไรบน iPad

{
	# ไม่ให้ Caddy เปิดพอร์ต 80/443 เอง (เปิดเฉพาะ 8090 ตามที่กำหนด)
	auto_https disable_redirects
	http_port 8089
	admin off
}

https://<ชื่อเว็บ เช่น pelnav.xxx.ac.th>:8090 {
	# แบบ ก: ใบรับรองจากฝ่ายไอที (ไฟล์ .pem 2 ไฟล์)
	tls C:\PelNav\certs\cert.pem C:\PelNav\certs\key.pem

	reverse_proxy 127.0.0.1:8091
	encode gzip
	log {
		output file C:\PelNav\caddy\logs\access.log {
			roll_keep_for 2160h
		}
	}
}
